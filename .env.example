# Copy to .env and fill in. Never commit .env.

# Which LLM drives the agent: scripted | gemini | openai_compat
# "scripted" replays deterministic tool-call scripts: no API key, no cost.
LLM_PROVIDER=scripted

# Gemini (default real provider). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# minimal | low | medium | high (low saves free-tier quota and latency)
GEMINI_THINKING_LEVEL=low

# Any OpenAI-compatible API (backup provider). Groq preset shown in README.
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Client-side request pacing for real providers (requests per minute).
LLM_MAX_RPM=8
